{
  "title": "CareScribe - Agent Pipeline Overview",
  "uid": "carescribe-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Pipeline runs (rate, 5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(carescribe_pipeline_runs_total[5m])",
          "legendFormat": "pipeline runs/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pipeline latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(carescribe_pipeline_latency_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(carescribe_pipeline_latency_seconds_bucket[5m]))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Per-agent confidence (avg, 5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (agent) (rate(carescribe_agent_confidence_sum[5m])) / sum by (agent) (rate(carescribe_agent_confidence_count[5m]))",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Validator flags (rate, 5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(carescribe_validation_flags_total[5m])",
          "legendFormat": "flags/s"
        }
      ]
    }
  ]
}
